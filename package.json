{
  "name": "skilltogether",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:validate": "prisma validate --schema apps/api/prisma/schema.prisma",
    "dev:api": "pnpm --filter @skilltogether/api dev",
    "dev:web": "pnpm --filter @skilltogether/web dev",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm db:generate && tsc -b --noEmit",
    "test": "pnpm db:generate && vitest run",
    "e2e": "pnpm db:generate && pnpm --filter @skilltogether/api build && tsx scripts/run-e2e.ts",
    "build": "pnpm db:generate && pnpm -r --if-present build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^11.1.28",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
