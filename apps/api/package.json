{
  "name": "@skilltogether/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "dev": "pnpm run build && node dist/main.js",
    "start:test": "pnpm run build && node dist/main.js",
    "build": "pnpm --filter @skilltogether/shared build && pnpm -w db:generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "seed": "pnpm run build && node dist/seed.js",
    "audit:german": "pnpm run build && node dist/german-content-audit.js"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^13.4.2",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/graphql": "^13.4.2",
    "@nestjs/platform-express": "^11.1.28",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@skilltogether/shared": "workspace:*",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "graphql": "^16.14.2",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  }
}
