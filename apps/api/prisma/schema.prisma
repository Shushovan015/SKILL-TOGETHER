generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum UserRole {
  LEARNER
  CONTENT_ADMIN
  SYSTEM_ADMIN

  @@map("user_role")
}

enum TrackType {
  SOFTWARE_ENGINEERING
  PROJECT_MANAGEMENT
  GERMAN

  @@map("track_type")
}

enum EnrollmentStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED

  @@map("enrollment_status")
}

enum ContentStatus {
  DRAFT
  REVIEWED
  APPROVED
  ARCHIVED

  @@map("content_status")
}

enum TaskStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  MISSED
  RESCHEDULED
  SKIPPED
  CANCELLED

  @@map("task_status")
}

enum ReflectionVisibility {
  PRIVATE
  PARTNER_VISIBLE

  @@map("reflection_visibility")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  REVOKED

  @@map("invitation_status")
}

enum AssessmentAttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  NEEDS_MANUAL_GRADING
  GRADED
  PASSED
  FAILED

  @@map("assessment_attempt_status")
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_SELECT
  TRUE_FALSE
  SHORT_ANSWER
  CODE_CHALLENGE
  DEBUGGING_CHALLENGE
  SCENARIO
  CASE_STUDY
  PRACTICAL_ASSIGNMENT
  REFLECTION

  @@map("question_type")
}

model User {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                  String               @unique
  passwordHash           String               @map("password_hash")
  status                 UserStatus           @default(ACTIVE)
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  profile                UserProfile?
  roles                  UserRoleAssignment[]
  sessions               Session[]
  enrollments            Enrollment[]
  taskAttempts           TaskAttempt[]
  reflections            Reflection[]
  progressSnapshots      ProgressSnapshot[]
  assessmentAttempts     AssessmentAttempt[]
  sentPartnerInvitations PartnerInvitation[]  @relation("PartnerInvitationInviter")
  receivedPartnerInvitations PartnerInvitation[] @relation("PartnerInvitationInvitee")
  partnerConnectionsAsA  PartnerConnection[]  @relation("PartnerConnectionUserA")
  partnerConnectionsAsB  PartnerConnection[]  @relation("PartnerConnectionUserB")
  blockedUsers           BlockedUser[]        @relation("BlockedUserBlocker")
  blockedByUsers         BlockedUser[]        @relation("BlockedUserBlocked")
  authoredLessonVersions LessonVersion[]      @relation("LessonVersionAuthor")
  reviewedLessonVersions LessonVersion[]      @relation("LessonVersionReviewer")
  auditEvents            AuditEvent[]         @relation("AuditEventActor")

  @@map("users")
}

model UserProfile {
  userId               String    @id @map("user_id") @db.Uuid
  displayName          String    @map("display_name")
  timeZone             String    @map("time_zone")
  preferredSessionTime DateTime? @map("preferred_session_time") @db.Time(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserRoleAssignment {
  userId String   @map("user_id") @db.Uuid
  role   UserRole
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model Session {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  sessionHash String    @unique @map("session_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "sessions_user_id_expires_at_idx")
  @@map("sessions")
}

model LearningTrack {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String           @unique
  type        TrackType
  title       String
  description String
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  modules     LearningModule[]
  enrollments Enrollment[]
  assessments Assessment[]

  @@index([type, active], map: "learning_tracks_type_active_idx")
  @@map("learning_tracks")
}

model LearningModule {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trackId   String        @map("track_id") @db.Uuid
  sequence  Int
  title     String
  summary   String
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  track     LearningTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@unique([trackId, sequence], map: "modules_track_id_sequence_key")
  @@index([trackId, sequence], map: "modules_track_id_sequence_idx")
  @@map("modules")
}

model Lesson {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId               String               @map("module_id") @db.Uuid
  slug                   String
  sequence               Int
  defaultDurationMinutes Int                  @map("default_duration_minutes")
  difficulty             String
  required               Boolean              @default(true)
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  module                 LearningModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  versions               LessonVersion[]
  prerequisites          LessonPrerequisite[] @relation("LessonPrerequisites")
  requiredBy             LessonPrerequisite[] @relation("LessonRequiredBy")

  @@unique([moduleId, sequence], map: "lessons_module_id_sequence_key")
  @@unique([moduleId, slug], map: "lessons_module_id_slug_key")
  @@index([moduleId, sequence], map: "lessons_module_id_sequence_idx")
  @@map("lessons")
}

model LessonPrerequisite {
  lessonId             String @map("lesson_id") @db.Uuid
  prerequisiteLessonId String @map("prerequisite_lesson_id") @db.Uuid
  lesson               Lesson @relation("LessonPrerequisites", fields: [lessonId], references: [id], onDelete: Cascade)
  prerequisiteLesson   Lesson @relation("LessonRequiredBy", fields: [prerequisiteLessonId], references: [id], onDelete: Restrict)

  @@id([lessonId, prerequisiteLessonId])
  @@index([prerequisiteLessonId], map: "lesson_prerequisites_prerequisite_lesson_id_idx")
  @@map("lesson_prerequisites")
}

model LessonVersion {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId          String           @map("lesson_id") @db.Uuid
  version           Int
  status            ContentStatus    @default(DRAFT)
  title             String
  learningObjective String           @map("learning_objective")
  outcomes          Json             @db.JsonB
  explanationMd     String           @map("explanation_md")
  relevanceMd       String           @map("relevance_md")
  examples          Json             @db.JsonB
  commonMistakes    Json             @map("common_mistakes") @db.JsonB
  assessmentTags    String[]         @map("assessment_tags")
  authorId          String           @map("author_id") @db.Uuid
  reviewerId        String?          @map("reviewer_id") @db.Uuid
  approvedAt        DateTime?        @map("approved_at") @db.Timestamptz(6)
  archivedAt        DateTime?        @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lesson            Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  author            User             @relation("LessonVersionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewer          User?            @relation("LessonVersionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  resources         Resource[]
  exercises         Exercise[]
  knowledgeChecks   KnowledgeCheck[]
  dailyTasks        DailyTask[]

  @@unique([lessonId, version], map: "lesson_versions_lesson_id_version_key")
  @@index([lessonId, status], map: "lesson_versions_lesson_id_status_idx")
  @@map("lesson_versions")
}

model Resource {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonVersionId String        @map("lesson_version_id") @db.Uuid
  title           String
  provider        String        @default("Unknown")
  url             String
  resourceType    String        @map("resource_type")
  difficulty      String        @default("Foundational")
  estimatedMinutes Int          @default(15) @map("estimated_minutes")
  description     String        @default("")
  verificationStatus String     @default("VERIFIED") @map("verification_status")
  required        Boolean       @default(false)
  approved        Boolean       @default(false)
  citation        String
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  lessonVersion   LessonVersion @relation(fields: [lessonVersionId], references: [id], onDelete: Cascade)

  @@map("resources")
}

model Exercise {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonVersionId String        @map("lesson_version_id") @db.Uuid
  kind            String
  promptMd        String        @map("prompt_md")
  expectedEvidence String       @map("expected_evidence")
  solutionNotesMd String?       @map("solution_notes_md")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  lessonVersion   LessonVersion @relation(fields: [lessonVersionId], references: [id], onDelete: Cascade)

  @@map("exercises")
}

model KnowledgeCheck {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonVersionId String        @map("lesson_version_id") @db.Uuid
  question        String
  answerKey       Json          @map("answer_key") @db.JsonB
  explanation     String
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  lessonVersion   LessonVersion @relation(fields: [lessonVersionId], references: [id], onDelete: Cascade)

  @@map("knowledge_checks")
}

model Enrollment {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  trackId         String           @map("track_id") @db.Uuid
  status          EnrollmentStatus @default(DRAFT)
  startDate       DateTime         @map("start_date") @db.Date
  targetOutcome   String           @map("target_outcome")
  experienceLevel String           @map("experience_level")
  learningPreferences Json?        @map("learning_preferences") @db.JsonB
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  track           LearningTrack    @relation(fields: [trackId], references: [id], onDelete: Restrict)
  studyPlan       StudyPlan?
  progressSnapshots ProgressSnapshot[]

  @@index([userId, trackId, status], map: "enrollments_user_id_track_id_status_idx")
  @@map("enrollments")
}

model StudyPlan {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enrollmentId          String        @unique @map("enrollment_id") @db.Uuid
  studyDays             Int[]         @map("study_days")
  availableMinutesByDay Json          @map("available_minutes_by_day") @db.JsonB
  assessmentDay         Int           @map("assessment_day")
  recoveryDay           Int           @map("recovery_day")
  preferredSessionTime  DateTime?     @map("preferred_session_time") @db.Time(6)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  enrollment            Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  pausePeriods          PausePeriod[]
  studyWeeks            StudyWeek[]

  @@map("study_plans")
}

model PausePeriod {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studyPlanId String    @map("study_plan_id") @db.Uuid
  startsOn    DateTime  @map("starts_on") @db.Date
  endsOn      DateTime  @map("ends_on") @db.Date
  reason      String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  studyPlan   StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)

  @@index([studyPlanId, startsOn], map: "pause_periods_study_plan_id_starts_on_idx")
  @@map("pause_periods")
}

model StudyWeek {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studyPlanId String      @map("study_plan_id") @db.Uuid
  weekNumber  Int         @map("week_number")
  startsOn    DateTime    @map("starts_on") @db.Date
  endsOn      DateTime    @map("ends_on") @db.Date
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  studyPlan   StudyPlan   @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  dailyTasks  DailyTask[]
  reflections Reflection[]
  progressSnapshots ProgressSnapshot[]
  assessmentAttempts AssessmentAttempt[]

  @@unique([studyPlanId, weekNumber], map: "study_weeks_study_plan_id_week_number_key")
  @@index([studyPlanId, startsOn], map: "study_weeks_study_plan_id_starts_on_idx")
  @@map("study_weeks")
}

model DailyTask {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studyWeekId            String        @map("study_week_id") @db.Uuid
  lessonVersionId        String        @map("lesson_version_id") @db.Uuid
  scheduledOn            DateTime      @map("scheduled_on") @db.Date
  status                 TaskStatus    @default(PLANNED)
  plannedDurationMinutes Int           @map("planned_duration_minutes")
  isRequired             Boolean       @map("is_required")
  sourceTaskId           String?       @map("source_task_id") @db.Uuid
  rescheduleReason       String?       @map("reschedule_reason")
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  studyWeek              StudyWeek     @relation(fields: [studyWeekId], references: [id], onDelete: Cascade)
  lessonVersion          LessonVersion @relation(fields: [lessonVersionId], references: [id], onDelete: Restrict)
  sourceTask             DailyTask?    @relation("TaskReschedules", fields: [sourceTaskId], references: [id], onDelete: SetNull)
  rescheduledTasks       DailyTask[]   @relation("TaskReschedules")
  attempts               TaskAttempt[]

  @@index([studyWeekId, scheduledOn], map: "daily_tasks_study_week_id_scheduled_on_idx")
  @@index([status, scheduledOn], map: "daily_tasks_status_scheduled_on_idx")
  @@index([lessonVersionId], map: "daily_tasks_lesson_version_id_idx")
  @@map("daily_tasks")
}

model TaskAttempt {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dailyTaskId        String   @map("daily_task_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  startedAt          DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  submittedAt        DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)
  durationMinutes    Int      @map("duration_minutes")
  completionEvidence Json     @map("completion_evidence") @db.JsonB
  lessonSnapshot     Json     @map("lesson_snapshot") @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  dailyTask          DailyTask @relation(fields: [dailyTaskId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reflection         Reflection?

  @@index([dailyTaskId], map: "task_attempts_daily_task_id_idx")
  @@index([userId, submittedAt], map: "task_attempts_user_id_submitted_at_idx")
  @@map("task_attempts")
}

model Reflection {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  taskAttemptId String?              @unique @map("task_attempt_id") @db.Uuid
  studyWeekId   String?              @map("study_week_id") @db.Uuid
  visibility    ReflectionVisibility @default(PRIVATE)
  body          String
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskAttempt   TaskAttempt?         @relation(fields: [taskAttemptId], references: [id], onDelete: Cascade)
  studyWeek     StudyWeek?           @relation(fields: [studyWeekId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], map: "reflections_user_id_created_at_idx")
  @@index([studyWeekId], map: "reflections_study_week_id_idx")
  @@map("reflections")
}

model ProgressSnapshot {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                    String    @map("user_id") @db.Uuid
  enrollmentId              String    @map("enrollment_id") @db.Uuid
  studyWeekId               String?   @map("study_week_id") @db.Uuid
  plannedCount              Int       @map("planned_count")
  completedCount            Int       @map("completed_count")
  weeklyCompletionPercentage Decimal   @map("weekly_completion_percentage") @db.Decimal(5, 2)
  currentStreak             Int       @map("current_streak")
  assessmentCompleted       Boolean   @default(false) @map("assessment_completed")
  overallProgressPercentage Decimal   @map("overall_progress_percentage") @db.Decimal(5, 2)
  updatedAt                 DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollment                Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  studyWeek                 StudyWeek? @relation(fields: [studyWeekId], references: [id], onDelete: SetNull)

  @@unique([userId, enrollmentId, studyWeekId], map: "progress_snapshots_user_enrollment_week_key")
  @@index([userId, enrollmentId, studyWeekId], map: "progress_snapshots_user_id_enrollment_id_study_week_id_idx")
  @@map("progress_snapshots")
}

model PartnerInvitation {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inviterId     String           @map("inviter_id") @db.Uuid
  inviteeEmail  String           @map("invitee_email")
  inviteeUserId String?          @map("invitee_user_id") @db.Uuid
  status        InvitationStatus @default(PENDING)
  tokenHash     String           @unique @map("token_hash")
  expiresAt     DateTime         @map("expires_at") @db.Timestamptz(6)
  respondedAt   DateTime?        @map("responded_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  inviter       User             @relation("PartnerInvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee       User?            @relation("PartnerInvitationInvitee", fields: [inviteeUserId], references: [id], onDelete: SetNull)

  @@index([inviterId, status], map: "partner_invitations_inviter_id_status_idx")
  @@index([inviteeEmail, status], map: "partner_invitations_invitee_email_status_idx")
  @@index([inviteeUserId, status], map: "partner_invitations_invitee_user_id_status_idx")
  @@map("partner_invitations")
}

model PartnerConnection {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userAId         String    @map("user_a_id") @db.Uuid
  userBId         String    @map("user_b_id") @db.Uuid
  status          String    @default("ACTIVE")
  sharingSettings Json      @map("sharing_settings") @db.JsonB
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  removedAt       DateTime? @map("removed_at") @db.Timestamptz(6)
  userA           User      @relation("PartnerConnectionUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB           User      @relation("PartnerConnectionUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId], map: "partner_connections_user_a_id_user_b_id_key")
  @@index([userAId, status], map: "partner_connections_user_a_id_status_idx")
  @@index([userBId, status], map: "partner_connections_user_b_id_status_idx")
  @@map("partner_connections")
}

model BlockedUser {
  blockerId     String   @map("blocker_id") @db.Uuid
  blockedUserId String   @map("blocked_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  blocker       User     @relation("BlockedUserBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUser   User     @relation("BlockedUserBlocked", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedUserId])
  @@index([blockedUserId], map: "blocked_users_blocked_user_id_idx")
  @@map("blocked_users")
}

model Assessment {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trackId   String              @map("track_id") @db.Uuid
  title     String
  type      String
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  track     LearningTrack       @relation(fields: [trackId], references: [id], onDelete: Cascade)
  versions  AssessmentVersion[]

  @@unique([trackId, type], map: "assessments_track_id_type_key")
  @@map("assessments")
}

model AssessmentVersion {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId      String              @map("assessment_id") @db.Uuid
  version           Int
  status            ContentStatus       @default(REVIEWED)
  passingPercentage Decimal             @map("passing_percentage") @db.Decimal(5, 2)
  rules             Json                @db.JsonB
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  approvedAt        DateTime?           @map("approved_at") @db.Timestamptz(6)
  assessment        Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questions         Question[]
  attempts          AssessmentAttempt[]

  @@unique([assessmentId, version], map: "assessment_versions_assessment_id_version_key")
  @@index([assessmentId, status], map: "assessment_versions_assessment_id_status_idx")
  @@map("assessment_versions")
}

model Question {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentVersionId String            @map("assessment_version_id") @db.Uuid
  type                QuestionType
  promptMd            String            @map("prompt_md")
  options             Json?             @db.JsonB
  answerKey           Json              @map("answer_key") @db.JsonB
  points              Int
  assessmentTags      String[]          @map("assessment_tags")
  gradingMode         String            @map("grading_mode")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  assessmentVersion   AssessmentVersion @relation(fields: [assessmentVersionId], references: [id], onDelete: Cascade)
  answers             Answer[]

  @@unique([assessmentVersionId, promptMd], map: "questions_assessment_version_id_prompt_md_key")
  @@index([assessmentVersionId, type], map: "questions_assessment_version_id_type_idx")
  @@map("questions")
}

model AssessmentAttempt {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String                  @map("user_id") @db.Uuid
  studyWeekId         String                  @map("study_week_id") @db.Uuid
  assessmentVersionId String                  @map("assessment_version_id") @db.Uuid
  attemptNumber       Int                     @default(1) @map("attempt_number")
  status              AssessmentAttemptStatus @default(NOT_STARTED)
  startedAt           DateTime                @default(now()) @map("started_at") @db.Timestamptz(6)
  submittedAt         DateTime?               @map("submitted_at") @db.Timestamptz(6)
  gradedAt            DateTime?               @map("graded_at") @db.Timestamptz(6)
  scoreEarned         Decimal?                @map("score_earned") @db.Decimal(7, 2)
  scorePossible       Decimal?                @map("score_possible") @db.Decimal(7, 2)
  percentage          Decimal?                @db.Decimal(5, 2)
  passed              Boolean?
  assessmentSnapshot  Json                    @map("assessment_snapshot") @db.JsonB
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyWeek           StudyWeek               @relation(fields: [studyWeekId], references: [id], onDelete: Cascade)
  assessmentVersion   AssessmentVersion       @relation(fields: [assessmentVersionId], references: [id], onDelete: Restrict)
  answers             Answer[]

  @@unique([userId, studyWeekId, assessmentVersionId, attemptNumber], map: "assessment_attempts_user_week_version_attempt_key")
  @@index([userId, studyWeekId], map: "assessment_attempts_user_id_study_week_id_idx")
  @@map("assessment_attempts")
}

model Answer {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentAttemptId String            @map("assessment_attempt_id") @db.Uuid
  questionId          String            @map("question_id") @db.Uuid
  response            Json              @db.JsonB
  questionSnapshot    Json              @map("question_snapshot") @db.JsonB
  score               Decimal?          @db.Decimal(7, 2)
  feedback            String?
  graderType          String            @map("grader_type")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  assessmentAttempt   AssessmentAttempt @relation(fields: [assessmentAttemptId], references: [id], onDelete: Cascade)
  question            Question          @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([assessmentAttemptId, questionId], map: "answers_assessment_attempt_id_question_id_key")
  @@map("answers")
}

model AuditEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  eventType   String   @map("event_type")
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  safeMetadata Json    @map("safe_metadata") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor        User?    @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt], map: "audit_events_entity_type_entity_id_created_at_idx")
  @@map("audit_events")
}
