# SkillTogether environment example
# Copy values into a local .env file when implementation begins.

NODE_ENV=development

# Database
DATABASE_URL=postgresql://skilltogether:change-me@localhost:5432/skilltogether_dev
TEST_DATABASE_URL=postgresql://skilltogether:change-me@localhost:5432/skilltogether_test

# Backend
API_PORT=4000
AUTH_PERSISTENCE=prisma
CONTENT_PERSISTENCE=prisma
SESSION_COOKIE_NAME=skilltogether.sid
SESSION_SECRET=replace-with-a-long-random-development-secret
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_TTL_DAYS=14
CSRF_COOKIE_NAME=skilltogether.csrf
CSRF_HEADER_NAME=x-csrf-token
CSRF_SECRET=replace-with-a-long-random-development-secret

# Frontend and CORS
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000
VITE_API_URL=http://localhost:4000/graphql
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email placeholders for future password reset and verification flows
EMAIL_FROM=no-reply@example.test
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# Optional AI integration
AI_PROVIDER=disabled
AI_API_KEY=
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=1

# Observability
LOG_LEVEL=debug
SENTRY_DSN=
